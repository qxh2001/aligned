# Use a dedicated development database; never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aligned
# For a remote database, TLS and hostname/IP verification are required.
# Use sslmode=verify-full (or omit sslmode). Set the public CA PEM if privately signed.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=2
# Alternatively set SUPABASE_DATABASE_URL to your development project's pooler URL.
SESSION_SECRET=replace-with-a-long-random-secret
ANTHROPIC_API_KEY=
# Anonymous analysis stays disabled unless explicitly enabled.
ALLOW_PUBLIC_AI_DEMO=false
AI_HOURLY_LIMIT=5
AI_DAILY_LIMIT=100
# Optional Gmail SMTP notifications:
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
